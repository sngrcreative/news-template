---
import Layout, { type Props as LProps } from './layout.astro'
import { Picture } from 'astro:assets'

export interface Props extends LProps {
  image?: string | undefined
}

const { title, image, class: className, ...props } = Astro.props
---

<Layout title={title} class:list={[className]} {...props}>
  {/* <body /> */}
  <main>
    <hgroup>
      <h1>{title}</h1>
      {
        image && (
          <Picture
            src={image}
            alt=''
            formats={['avif', 'webp']}
            layout='constrained'
            inferSize
            priority
          />
        )
      }
      <slot name='hgroup' />
    </hgroup>

    <slot />
  </main>

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>
