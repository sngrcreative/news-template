---
import PageLayout, { type Props as LProps } from '~/layouts/page.astro'
import { getLiveEntry, render } from 'astro:content'

export const prerender = false

const { year, month, post: slug } = Astro.params
const { entry: post } = await getLiveEntry('posts', {
  id: `${year}/${month}/${slug}`
})
if (!post) {
  return Astro.redirect('/404')
}

// @ts-ignore
const { Content } = await render(post)
const props = {
  title: post.data.title ?? ''
} satisfies LProps
---

<PageLayout {...props}>
  <Content />
</PageLayout>
