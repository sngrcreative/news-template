---
import Layout from '~/layouts/layout.astro'
import { getCollection } from 'astro:content'

const pages = await getCollection('pages')
---

<Layout>
  <h1>Astro</h1>
  <ul>
    {
      pages.map((page) => (
        <li>
          <a href={page.id}>{page.data.title}</a>
        </li>
      ))
    }
  </ul>
</Layout>
